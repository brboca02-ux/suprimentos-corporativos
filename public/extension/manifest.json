{
  "manifest_version": 3,
  "name": "ImobiHunter Pro - Captador Zap Imóveis",
  "version": "1.2.1",
  "description": "Captura imóveis, fotos em alta resolução, valores, m² e contatos/telefones no Zap Imóveis e envia para o CRM de prospecção.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.zapimoveis.com.br/*",
    "*://*.vivareal.com.br/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zapimoveis.com.br/*",
        "*://*.vivareal.com.br/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
